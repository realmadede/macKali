[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
dash-max-icon-size=48
icon-size-fixed=false
show-trash=true
show-mounts=true
show-apps-at-top=false./scripts/providers/qt-provider.sh --install --theme light
zsh: no such file or directory: ./scripts/providers/qt-provider.sh
custom-theme-shrink=true
transparency-mode='DYNAMIC'
running-indicator-style='DOTS'
